{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salon-booking-bot/schemas/intent.schema.json",
  "title": "intent",
  "description": "The structured output the LLM must return per message. Validated in n8n; on failure → error branch + handoff (MASTER-BRIEF §7).",
  "type": "object",
  "required": ["intent", "confidence", "slots"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "description": "Allow-list only — no other action exists.",
      "enum": ["book", "capture_lead", "answer_faq", "handoff", "unknown"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "If < confidenceThreshold (default 0.7) → human handoff."
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceId": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"], "description": "ISO 8601 date (YYYY-MM-DD) or null" },
        "time": { "type": ["string", "null"], "description": "HH:MM (24h) or null" },
        "customerName": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "reply": {
      "type": ["string", "null"],
      "description": "Optional draft reply text; deterministic templates from config are preferred."
    }
  }
}
