# .env.example — variable NAMES only, fake placeholders.
# Copy to .env and fill with REAL values. .env is gitignored and never committed.
# For production, the REAL secrets live in n8n Credentials / Vercel env — NOT here.

# --- Core ---
APP_ENV=development                  # development | staging | production

# --- Channels ---
ZERNIO_API_TOKEN=REPLACE_ME          # ⚠ verify Zernio is a real WhatsApp BSP (MASTER-BRIEF §13)
ZERNIO_WEBHOOK_SECRET=REPLACE_ME     # HMAC-verify inbound Zernio webhooks
WIDGET_SIGNING_SECRET=REPLACE_ME     # sign/verify website-widget requests (browser has no shared secret)

# --- Google Calendar (OAuth per client) ---
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
GOOGLE_CALENDAR_ID=REPLACE_ME        # the owner's calendar (their phone)

# --- Airtable (CRM / data) ---
AIRTABLE_API_KEY=REPLACE_ME
AIRTABLE_BASE_ID=REPLACE_ME

# --- LLM (cheap-model-first) ---
ANTHROPIC_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME

# --- n8n ---
N8N_ENCRYPTION_KEY=REPLACE_ME        # back this up; losing it makes stored credentials unreadable

# --- Safety brakes (see .claude/rules/spend-safety.md) ---
BOT_KILL_SWITCH=false                # true → bot goes handoff-only (global kill-switch)
LLM_COST_CAP_USD=REPLACE_ME          # hard spend cap per period
LLM_MAX_TURNS=REPLACE_ME             # per-conversation max-iteration
