  {
   "id": "verify-owner-signature",
   "name": "Verify Owner Signature",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -180,
    0
   ],
   "parameters": {
    "jsCode": "\n// A2 · Verify Owner Signature — HMAC-SHA256 over the RAW bytes, constant-time compare.\n//\n// WHY RAW: the dashboard signs the exact string it sends. If n8n re-serialises the parsed JSON, key order\n// and spacing change and a correct signature stops matching — paid for once already on the Zernio inbound.\n// _raw_source is reported so a drill can SEE which route supplied the bytes; a silent fallback between two\n// routes would hide the day the webhook stops producing binary.\n//\n// CORRECTED 2026-09-13: this instance has NO global `crypto` (typeof === 'undefined') but DOES have\n// require('crypto') since NODE_FUNCTION_ALLOW_BUILTIN=crypto. The build package said the opposite.\nconst crypto = require('crypto');\n\nconst item = $input.first();\nlet raw = '', src = 'none';\nif (item.binary && item.binary.data && item.binary.data.data) {\n  raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8'); src = 'binary';\n} else if (typeof item.json.body === 'string') {\n  raw = item.json.body; src = 'json.body:string';\n} else if (item.json.body && typeof item.json.body === 'object') {\n  raw = JSON.stringify(item.json.body); src = 'json.body:reserialised';\n}\n\nconst headers = item.json.headers || {};\nconst given = headers['x-owner-signature'];\nconst secret = $env.OWNER_HMAC_SECRET;\n\nlet sig_valid = false;\nif (typeof secret === 'string' && secret.length > 0 && typeof given === 'string' && raw.length > 0) {\n  const mine = crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex');\n  // timingSafeEqual THROWS on a length mismatch, so the length is checked first and a wrong-length\n  // signature is rejected without ever reaching the comparison.\n  if (given.length === mine.length) {\n    sig_valid = crypto.timingSafeEqual(Buffer.from(mine, 'utf8'), Buffer.from(given, 'utf8'));\n  }\n}\n\n// The body is parsed ONLY to carry fields forward. Nothing downstream acts on it before Signature Valid?.\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = {}; }\nconst ts = Number(parsed.ts);\nconst now = Math.floor(Date.now() / 1000);\n\nreturn [{ json: {\n  sig_valid,\n  _raw_source: src,\n  ts_fresh: Number.isFinite(ts) && Math.abs(now - ts) <= 300,\n  action: typeof parsed.action === 'string' ? parsed.action : '',\n  record_id: typeof parsed.record_id === 'string' ? parsed.record_id : '',\n  messageId: typeof parsed.messageId === 'string' ? parsed.messageId : '',\n  ts: Number.isFinite(ts) ? ts : null,\n} }];\n"
   }
  },
