  {
   "id": "validate-owner-action",
   "name": "Validate Owner Action",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    480,
    -160
   ],
   "parameters": {
    "jsCode": "\n// A5 · Validate Owner Action — THE ALLOW-LIST.\n// prompt-injection.md expressed in the engine: there is exactly ONE write verb, so there is nothing for a\n// compromise to escalate INTO. It is also why CRT #11 is auditable at all — the surface is one verb.\n// Mirrors OWNER_ACTIONS in web/dashboard/lib/ownerAction.ts; a second verb must be added in BOTH places\n// deliberately, never inherited.\nconst OWNER_ACTIONS = ['release_handoff'];\n\n// record_id is signature-verified, so this is not a trust boundary — it is an INJECTION boundary: the value\n// is interpolated into an Airtable formula downstream, and a formula built from an unconstrained string is\n// the same defect class whatever signed it.\nconst RECORD_ID = /^rec[A-Za-z0-9]{1,20}$/;\n\nconst j = $json;\nreturn [{ json: { ...j,\n  action_allowed: OWNER_ACTIONS.includes(j.action) && RECORD_ID.test(j.record_id) && j.messageId.length > 0,\n} }];\n"
   }
  },
