  {
   "id": "validate-release-target",
   "name": "Validate Release Target",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1140,
    -260
   ],
   "parameters": {
    "jsCode": "\n// A7 · Validate Release Target — a correct signature does not say WHICH conversation.\n// ARCH-DEC (2026-09-03) names the threat: \"an unsigned owner-action endpoint would let anyone unlock any\n// conversation\" — a SIGNED one with no target check has the same hole for anyone holding the secret.\n// Three conditions, all required: the record exists · stage === 'handoff' · it was touched recently.\nconst MAX_AGE_DAYS = 30;\n\nconst ctx = $('Validate Owner Action').first().json;\nconst rows = $input.all().filter(i => i.json && i.json.id && !i.json.error);\nconst row = rows[0] ? rows[0].json : null;\nconst f = row ? (row.fields || row) : {};\n\nconst found = !!row;\nconst stage = typeof f.stage === 'string' ? f.stage : '';\nconst lu = f.last_updated ? Date.parse(f.last_updated) : NaN;\nconst fresh = Number.isFinite(lu) ? (Date.now() - lu) <= MAX_AGE_DAYS * 86400000 : false;\n\nreturn [{ json: { ...ctx,\n  target_found: found,\n  target_locked: found && stage === 'handoff' && fresh,\n  target_record: found ? row.id : '',\n  // stage is carried for the alert text only; no customer content crosses this node.\n  target_stage: stage,\n} }];\n"
   }
  },
