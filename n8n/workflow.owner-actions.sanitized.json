   "parameters": {
    "jsCode": "\n// Telegram is asked for HTML parse mode (a bare `_` in Markdown mode broke a real send: \"can't parse\n// entities\", exec 2761 — the alert vanished while the caller got a 200). These three are the only\n// characters HTML mode treats as markup.\nconst esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// The release path's FAILURE alert — a separate class, deliberately not merged with the success one.\n// handoff.md: an infrastructure failure must never be indistinguishable from a normal outcome.\n// ⚠ This leaf is TERMINAL — no alert about a failed alert (Codex INVARIANT #1, infinite loop).\nconst ctx = $('Owner Replay Seen?').first().json;\nreturn [{ json: {\n  _alert_class: 'handoff_release_failed',\n  owner_alert_text: esc('⚠ Handoff release FAILED (dashboard)\\n'\n    + 'conversation: ' + String(ctx.target_record || '').slice(0, 3) + '…\\n'\n    + 'the lock was NOT opened — the owner saw an error and the row is unchanged or half-written\\n'\n    + 'at: ' + new Date().toISOString()),\n} }];\n"
