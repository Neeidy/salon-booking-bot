  {
   "id": "owner-replay-seen",
   "name": "Owner Replay Seen?",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2020,
    -460
   ],
   "parameters": {
    "jsCode": "\n// A8 · Owner replay check — booking-integrity.md item 1: the same click twice must produce ONE write.\n//\n// ⚠ MEASURED BOUND, stated rather than overclaimed: Record Owner Action Processed writes at the END, so a\n// replay arriving while the first is still IN FLIGHT finds nothing and proceeds. On the booking path a\n// deterministic calendar event id absorbs that; HERE THERE IS NO SUCH BACKSTOP. What makes it safe is that\n// the write is idempotent — setting stage='new' twice equals once. Do not write \"deduplicated\" on a sticky.\nconst ctx = $('Validate Release Target').first().json;\nconst hits = $input.all().filter(i => i.json && i.json.id && !i.json.error);\nreturn [{ json: { ...ctx, is_replay: hits.length > 0 } }];\n"
   }
  },
