    "jsCode": "\n// Telegram is asked for HTML parse mode (a bare `_` in Markdown mode broke a real send: \"can't parse\n// entities\", exec 2761 — the alert vanished while the caller got a 200). These three are the only\n// characters HTML mode treats as markup.\nconst esc = (t) => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// A11 · Build Owner Alert (Release) — class `handoff_released`.\n// An owner-initiated WRITE that leaves no trace is the one kind nobody can audit afterwards.\n// No customer content and no full record id in the text: an alert lands in a third-party chat log.\nconst ctx = $('Owner Replay Seen?').first().json;\nreturn [{ json: {\n  _alert_class: 'handoff_released',\n  _alert_at: new Date().toISOString(),\n  owner_alert_text: esc('🔓 Handoff released from the dashboard\\n'\n    + 'conversation: ' + String(ctx.target_record || '').slice(0, 3) + '…\\n'\n    + 'stage: handoff → new (last_intent cleared)\\n'\n    + 'at: ' + new Date().toISOString()),\n} }];\n"
   }
  },
