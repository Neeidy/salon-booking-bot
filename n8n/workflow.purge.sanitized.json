    {
      "parameters": {
        "jsCode": "// Compute PII Cutoff (FIX-1) — conversations.recent_messages is PII (the rolling last-5 customer\n// message texts). It is SCRUBBED after 30 days; the ROW is deliberately KEPT.\n// WHY not delete the row: deleting it would silently release a stage='handoff' lock (a handed-off\n// customer would start getting bot replies again with no human action) and would drop\n// cancel_target_id / confirm_turn state. Row deletion is a SEPARATE decision — UX-ARCHITECTURE §9 K2.\n// HONEST SCOPE: this scrubs message CONTENT only. sender_key (a phone number on whatsapp) stays for\n// the row's lifetime — this is not a full PII expiry.\nreturn [{ json: { pii_cutoff: $now.minus({ days: 30 }).toUTC().toISO() } }];"
      },
      "id": "purge_pii_cutoff",
      "name": "Compute PII Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "appXXXXXXXXXXXXXX",
          "mode": "list",
          "cachedResultName": "Barber Bot"
        },
        "table": {
          "__rl": true,
          "value": "tblXXXXXXXXXXXXXX",
          "mode": "list",
          "cachedResultName": "Conversations"
        },
        "filterByFormula": "={{ 'AND({recent_messages} != \"\", IS_BEFORE({last_updated}, DATETIME_PARSE(\"' + $json.pii_cutoff + '\")))' }}",
        "options": {}
      },
