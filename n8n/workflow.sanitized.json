{
  "name": "Salon Booking Bot — Main",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "barber-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 16],
      "id": "7b480c08-8217-4101-bcac-2c8d717405fa",
      "name": "Receive Inbound Message"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst channel = b.channel;\nconst senderId = channel === 'widget' ? b.sessionId : b.from;   // whatsapp → from\nif (!channel || !senderId) throw new Error('normalize: missing channel/senderId'); // fail-loud\nreturn [{ json: { channel, senderId, sender_key: `${channel}:${senderId}`, text: b.text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [624, 0],
      "id": "42983891-f17c-454d-b82e-1949a3a45098",
      "name": "Normalize Inbound"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "225f9630-f1de-454f-8e4c-d21efcae3374", "name": "reply", "value": "={{ $('Merge State').first().json.text }}", "type": "string" },
            { "id": "a260193f-a86b-4575-b603-aa9c55452dee", "name": "channel", "value": "={{ $('Merge State').first().json.channel }}", "type": "string" },
            { "id": "d68e5925-2e65-46e7-999f-82b32431b9f7", "name": "sender_key", "value": "={{ $('Merge State').first().json.sender_key }}", "type": "string" },
            { "id": "5b40d530-3820-44f5-a883-3b3e0afb5924", "name": "found", "value": "={{ $('Merge State').first().json.state.found }}", "type": "string" },
            { "id": "a304c0e5-94d5-4fc2-870e-7232428d7e0e", "name": "stage", "value": "={{ $('Merge State').first().json.state.stage }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1456, 0],
      "id": "35e6555e-2e67-45ae-9f86-9f79891b4dc5",
      "name": "Build Reply Payload"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"channel\": $json.channel, \"sender_key\": $json.sender_key, \"reply\": $json.reply } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1664, 0],
      "id": "ed9845ad-c695-4184-a8bb-bb0e0b07830e",
      "name": "Send Reply To Origin"
    },
    {
      "parameters": {
        "content": "CP0–CP2 — Salon Booking Bot core (Phase 2, checkpoints)\nFront gate: Receive → Load Config → Validate → Normalize\nState: Load State → Merge State → Save State (Airtable conversations, keyed by sender_key)\nReply: Build Reply → Respond. Reject (400) / Error (503) branches visible.\nMOCK config; no LLM yet (CP3). Adapter boundary = Normalize (Zernio in Phase 4).",
        "height": 260,
        "width": 420
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [-224, -288],
      "typeVersion": 1,
      "id": "4fb200a1-16c1-4b93-b708-9990ba3cb402",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// Load Config — MOCK client config (CP1).\n// one-swap-to-real: bu literal yerine client.config.json / n8n variable oku (Phase 4/template).\nconst config = {\n  business: { name: \"Demo Barber Co.\", timezone: \"Europe/Vienna\", locale: \"en-AT\" },\n  branding: { primaryColor: \"#16150F\", accentColor: \"#B4472E\", logoUrl: \"https://example.com/demo-barber-logo.png\" },\n  channels: {\n    whatsapp:  { enabled: true,  provider: \"zernio\" },\n    widget:    { enabled: true,  provider: \"webchat\" },\n    instagram: { enabled: false, provider: \"meta-graph\" }\n  },\n  services: [\n    { id: \"haircut\",       name: \"Haircut\",         durationMin: 30, priceEUR: 25 },\n    { id: \"beard\",         name: \"Beard Trim\",      durationMin: 20, priceEUR: 15 },\n    { id: \"haircut_beard\", name: \"Haircut + Beard\", durationMin: 45, priceEUR: 35 }\n  ],\n  workingHours: {\n    mon: [\"10:00-19:00\"], tue: [\"10:00-19:00\"], wed: [\"10:00-19:00\"],\n    thu: [\"10:00-19:00\"], fri: [\"10:00-19:00\"], sat: [\"10:00-18:00\"], sun: []\n  },\n  bot: { tone: \"friendly, concise, speaks English\", confidenceThreshold: 0.7, maxTurnsPerConversation: 12 },\n  messageTemplates: {\n    greeting: \"Hi! Welcome to Demo Barber Co. How can I help?\",\n    askService: \"Which service would you like? (Haircut / Beard Trim / Haircut + Beard)\",\n    askDateTime: \"What day and time works for you?\",\n    bookingConfirmed: \"You're booked: {service}, {date} {time}. See you then!\",\n    handoff: \"I'm passing you to a team member — we'll get back to you shortly.\",\n    outsideHours: \"We're outside working hours right now. We've got your request and will reply soon.\"\n  }\n};\nreturn [{ json: { ...$json, config } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [208, 16],
      "id": "46d66427-01a4-44e8-b2cd-4b6a546f392b",
      "name": "Load Config"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "id": "77d1bb26-d784-4087-87f7-9dae02bac8cb", "leftValue": "={{ $json.config.channels?.[$json.body?.channel]?.enabled === true }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } },
            { "id": "ed46aaf8-7200-4f83-873d-1e8ad928054e", "leftValue": "={{ ($json.body?.text ?? '').toString().trim() }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } },
            { "id": "477df25c-1b0e-454f-b395-72ab634e833e", "leftValue": "={{ ($json.body?.text ?? '').toString().length }}", "rightValue": 1000, "operator": { "type": "number", "operation": "lte" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [416, 16],
      "id": "b2e90b17-6568-4603-ac64-2b7fed999270",
      "name": "Validate Payload"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"error\": \"invalid_payload\", \"handoff\": true } }}",
        "options": { "responseCode": 400 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [528, 176],
      "id": "a648a8d6-3037-4b19-8b7d-f266fcde98d5",
      "name": "Send Reject Response"
    },
    {
      "parameters": {
        "operation": "search",
        "base": { "__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "list", "cachedResultName": "Barber Bot", "cachedResultUrl": "https://airtable.com/appXXXXXXXXXXXXXX" },
        "table": { "__rl": true, "value": "tblXXXXXXXXXXXXXX", "mode": "list", "cachedResultName": "Conversations", "cachedResultUrl": "https://airtable.com/appXXXXXXXXXXXXXX/tblXXXXXXXXXXXXXX" },
        "filterByFormula": "={{ '{sender_key} = \"' + $json.sender_key + '\"' }}",
        "options": {}
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [832, 0],
      "id": "e9f40f4c-c03b-40c0-b83b-c700b38fa502",
      "name": "Load State",
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL_ID", "name": "Airtable Personal Access Token account" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Merge State — Airtable sonucunu ($json) şu anki mesajla (Normalize) birleştir.\nconst norm = $('Normalize Inbound').first().json;   // {channel, senderId, sender_key, text}\nconst rec  = $json;                                 // Load State: yeni müşteride {}, yoksa {id, createdTime, fields:{...}}\nconst f    = rec.fields || {};                      // ⚠ Airtable alanları 'fields' altında NESTED\n\nconst found = !!(rec && rec.id);                    // Airtable kayıt id'si varsa \"bulundu\"\nconst state = {\n  found,\n  stage: found ? (f.stage ?? 'new') : 'new',\n  last_updated_prev: found ? (f.last_updated ?? null) : null\n};\n\nreturn [{ json: { ...norm, state } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 0],
      "id": "fb423cf5-37db-4df1-8584-87e913ddce66",
      "name": "Merge State"
    },
    {
      "parameters": {
        "operation": "upsert",
        "base": { "__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "list", "cachedResultName": "Barber Bot", "cachedResultUrl": "https://airtable.com/appXXXXXXXXXXXXXX" },
        "table": { "__rl": true, "value": "tblXXXXXXXXXXXXXX", "mode": "list", "cachedResultName": "Conversations", "cachedResultUrl": "https://airtable.com/appXXXXXXXXXXXXXX/tblXXXXXXXXXXXXXX" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "sender_key": "={{ $json.sender_key }}",
            "stage": "={{ $json.state.stage }}",
            "last_updated": "={{ $now.toUTC().toISO() }}"
          },
          "matchingColumns": ["sender_key"],
          "schema": [
            { "id": "id", "displayName": "id", "required": false, "defaultMatch": true, "display": true, "type": "string", "readOnly": true, "removed": true },
            { "id": "sender_key", "displayName": "sender_key", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "readOnly": false, "removed": false },
            { "id": "stage", "displayName": "stage", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "options", "options": [ { "name": "new", "value": "new" }, { "name": "collecting", "value": "collecting" }, { "name": "ready", "value": "ready" }, { "name": "done", "value": "done" }, { "name": "handoff", "value": "handoff" } ], "readOnly": false, "removed": false },
            { "id": "slot_service", "displayName": "slot_service", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "readOnly": false, "removed": false },
            { "id": "slot_date", "displayName": "slot_date", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "readOnly": false, "removed": false },
            { "id": "slot_time", "displayName": "slot_time", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "readOnly": false, "removed": false },
            { "id": "last_updated", "displayName": "last_updated", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "dateTime", "readOnly": false, "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [1248, 0],
      "id": "9bf0a485-8e8e-4ec5-89fd-f8d940053f51",
      "name": "Save State",
      "credentials": {
        "airtableTokenApi": { "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL_ID", "name": "Airtable Personal Access Token account" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"error\": \"state_unavailable\", \"handoff\": true } }}",
        "options": { "responseCode": 503 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1360, 240],
      "id": "00c7bed5-8213-4505-8ec0-1249d8eeb19e",
      "name": "Send Error Response"
    }
  ],
  "connections": {
    "Receive Inbound Message": { "main": [[{ "node": "Load Config", "type": "main", "index": 0 }]] },
    "Load Config": { "main": [[{ "node": "Validate Payload", "type": "main", "index": 0 }]] },
    "Validate Payload": { "main": [[{ "node": "Normalize Inbound", "type": "main", "index": 0 }], [{ "node": "Send Reject Response", "type": "main", "index": 0 }]] },
