    "Merge State": { "main": [[{ "node": "Save State", "type": "main", "index": 0 }]] },
    "Save State": { "main": [[{ "node": "Build Reply Payload", "type": "main", "index": 0 }], [{ "node": "Send Error Response", "type": "main", "index": 0 }]] },
    "Build Reply Payload": { "main": [[{ "node": "Send Reply To Origin", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
